{
  // markdownlint-cli2 configuration for monorepo blago-nko/ecosystem
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD004": { "style": "consistent" },
    "MD007": { "indent": 2 },
    "MD030": { "ul_single": 1, "ol_single": 1, "ul_multi": 1, "ol_multi": 1 }
  },
  "ignores": [
    "node_modules/**",
    "public/**",
    "dist/**",
    ".next/**",
    "out/**",
    ".astro/**",
    "pagefind/**",
    "resources/_gen/**",
    "archive/legacy-tests/test_out/**"
  ]
}
